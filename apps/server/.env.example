# From apps/server cwd, ../../data = repo ./data
DATA_DIR=../../data
PORT=8787
HOST=0.0.0.0
# LLM — leave empty to use mock unless you configure OpenRouter in the app (Command bar → ⋯ → Model settings).
# Precedence per request: modelId "mock" → mock; "openrouter:…" / "openrouter" with saved key → OpenRouter (profile
# file under DATA_DIR/profiles/default/llm.json); else if ANTHROPIC_API_KEY and modelId ≠ "openai" → Anthropic; else if
# OPENAI_API_KEY → OpenAI-compatible (OPENAI_BASE_URL defaults to api.openai.com).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
DEFAULT_MODEL_ID=mock
# Minimum milliseconds between automatic mutation snapshots (0 = always write)
SNAPSHOT_MUTATION_MIN_INTERVAL_MS=4000
# Set to 1 to allow fetch transcribe for private / local URLs (not recommended)
TRANSCRIBE_ALLOW_PRIVATE=0
# Dev-only: register POST /api/dev/reapply-flagship-demo-recipes (rewrites Crypto + Research demo widgets)
# AIRIS_ALLOW_FLAGSHIP_DEMO_RECIPE_REFRESH=1
# Live Chromium for workspace browser — uncomment after: npm run setup:playwright (repo root)
# AIRIS_PLAYWRIGHT=1
# Serve fetched pages with scripts/iframes in the embedded browser (remote JS runs as YOUR app origin — solo dev only)
# AIRIS_PREVIEW_UNSAFE_FULL_PAGE=1
# Solo / lab only: allow <<<EXECUTION type: browser.evaluate>>> (model script runs inside headless page — powerful;
# never on a shared or internet-exposed host without understanding risk). Requires AIRIS_PLAYWRIGHT=1.
# AIRIS_PERSONAL_BROWSER_EVAL=1
#
# Reference library: PDF text + optional embeddings (hybrid search) + optional vision captions on ingest.
# Uses the same OpenRouter / OpenAI keys as chat when profile keys are set (or OPENROUTER_API_KEY / OPENAI_API_KEY).
# AIRIS_EMBEDDING_MODEL=openai/text-embedding-3-small
# Optional: separate embeddings base (defaults to chat API root).
# AIRIS_EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
# Vision auto-caption (multipart field autoCaption=1); unset to disable API calls.
# AIRIS_VISION_CAPTION_MODEL=openai/gpt-4o-mini
# Set to 0 to omit reference-library excerpts from the chat system prompt.
# AIRIS_REFERENCE_RAG_PROMPT=1
#
# CLI catalog widget: allow POST /api/spaces/:id/cli-tools/run (allowlisted Printing Press binaries on PATH).
# Uncomment for local dev so the CLI catalog widget can run tools; use 0 or omit on untrusted hosts.
# AIRIS_CLI_TOOLS=1
#
# CLI run summaries: same resolveLlmRuntime keys as chat (no extra product). Heuristic always runs; LLM adds plain English when keys exist.
# AIRIS_CLI_SUMMARY_LLM=0
# AIRIS_CLI_SUMMARY_MODEL_ID=openrouter:openai/gpt-4o-mini
# AIRIS_CLI_SUMMARY_ANTHROPIC_MODEL=claude-3-5-haiku-20241022
