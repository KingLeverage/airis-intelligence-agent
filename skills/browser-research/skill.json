{
  "id": "browser-research",
  "name": "Browser Research",
  "description": "Navigate pages, use transcription context, and suggest browser actions safely.",
  "version": "0.1.0",
  "category": "browser",
  "tags": ["browser", "scrape", "navigate", "page"],
  "triggers": ["open url", "browse", "website", "click", "page", "navigate", "browser"],
  "allowedExecutionTypes": [
    "browser.navigate",
    "browser.click",
    "browser.type",
    "browser.scroll",
    "browser.back",
    "widget.create"
  ],
  "recommendedWidgets": ["note", "html-card"],
  "promptHint": "Use when the user works with live or transcribed web pages.",
  "entryInstructionFile": "SKILL.md",
  "enabledByDefault": true
}
